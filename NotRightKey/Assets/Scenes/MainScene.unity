--- !u!114 &1782451101
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1782451099}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.990566, g: 0.97598225, b: 0.378471, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 0e63761de8abf2c47aabb58dd22e2a09, type: 3}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 10
    m_MaxSize: 80
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0413\u043B\u0430\u0432\u043D\u044B\u0439 \u0433\u0435\u0440\u043E\u0439
    \u043A\u043E\u043B\u043E\u0431\u043E\u043A \u043F\u043E\u043F\u0430\u043B \u0432
    \u043C\u0438\u0440 IT. \u043D\u0435\u0436\u0434\u0430\u043D\u043D\u043E \u043D\u0435\u0433\u0430\u0434\u0430\u043D\u043D\u043E
    \u043D\u0430 \u043D\u0435\u0433\u043E \u043B\u0435\u0442\u044F\u0442 \u043A\u0430\u043C\u043D\u0438
    \u0438 \u043C\u043E\u043B\u043D\u0438\u0438, \u043B\u044C\u0451\u0442\u0441\u044F
    \u0432\u043E\u0434\u0430, \u043E\u043D \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442
    \u0432 \u043E\u0433\u043E\u043D\u044C \u0438 \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435
    \u043E\u0431\u043B\u0430\u043A\u043E. \u041D\u0435\u043C\u043D\u043E\u0433\u0438\u0435
    \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u043C\u044B\u0435 \u0431\u043E\u043D\u0443\u0441\u044B
    \u043E\u0442\u0447\u0430\u0441\u0442\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442
    \u043D\u0435 \u043F\u043E\u0433\u0438\u0431\u043D\u0443\u0442\u044C. \u041E\u043D
    \u0445\u043E\u0447\u0435\u0442 \u0432\u044B\u0440\u0432\u0430\u0442\u044C\u0441\u044F
    \u0441 \u044D\u0442\u043E\u0439 \u0437\u043B\u043E\u0439 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u044B.
    \u041D\u043E \u0442\u0443\u0442 \u0435\u0449\u0451 \u043D\u0430\u043F\u0430\u0441\u0442\u044C
    - \u043B\u0435\u0448\u0438\u0439, \u0443 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u043A\u043B\u044E\u0447 \u043E\u0442 \u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0433\u043E
    \u043F\u043E\u0440\u0442\u0430\u043B\u0430. \u0427\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C
    \u043A\u043B\u044E\u0447, \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C
    \u043B\u0435\u0448\u0435\u0433\u043E. \n\r\n\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    :\r\n\u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435 - \u0441\u0442\u0440\u0435\u043B\u043A\u0438-\u043A\u043B\u0430\u0432\u0438\u0448\u0438
    \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u044B \u0438\u043B\u0438
    \u041B\u041A\u041C \u043F\u043E \u0442\u0430\u043A\u0438\u043C \u0436\u0435 \u043A\u043D\u043E\u043F\u043A\u0430\u043C
    \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435\r\n\u0410\u0442\u0430\u043A\u0430
    - shift \u0438 alt \u0441\u043B\u0435\u0432\u0430 \u0438\u043B\u0438 \u041B\u041A\u041C
    \u043F\u043E \u0442\u0430\u043A\u0438\u043C \u0436\u0435 \u043A\u043D\u043E\u043F\u043A\u0430\u043C
    \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435\n\r\n\u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435
    \u043A\u043E\u043B\u043E\u0431\u043A\u0443 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
    \u0434\u043E\u043C\u043E\u0439 \u043A \u0434\u0435\u0434\u0443 \u0438 \u0431\u0430\u0431\u043A\u0435
    !"
